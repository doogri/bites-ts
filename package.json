{
  "name": "ideas-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "build:client": "(cd client && npm install && npm run build)",
    "build:all": "npm run build && npm run build:client",
    "invoice:cli": "npm run build && node dist/lib/invoicesCli.js",
    "invoice:month": "npm run build && node dist/lib/invoicesMonthSummary.js",
    "postinstall": "tsc",
    "prestart": "fuser -k 3000/tcp || true",
    "start": "npm run migration:run && node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "tsc && npm run typeorm migration:generate -- -d  ./dist/lib/data-source.js",
    "migration:run": "tsc && npm run typeorm migration:run -- -d ./dist/lib/data-source.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/crawler": "^1.2.3",
    "@types/express": "^4.17.17",
    "@types/node": "^20.17.30",
    "@types/node-telegram-bot-api": "^0.61.7",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.0.2",
    "@types/html-to-text": "^9.0.1",
    "@types/validator": "^13.15.2",
    "crawler": "^1.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "html-to-text": "^9.0.5",
    "node-telegram-bot-api": "^0.61.0",
    "openai": "^4.6.0",
    "pdf-parse-debugging-disabled": "^1.1.1",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.1",
    "typeorm": "^0.3.22",
    "validator": "^13.15.15"
  },
  "type": "module"
}
